# Database (use Supabase connection string in production)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/invoice_system

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudflare R2 (file storage)
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=invoice-images

# JWT Auth
JWT_SECRET_KEY=change-this-to-a-random-secure-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — Vercel production URL (set on Render)
FRONTEND_URL=https://your-app.vercel.app
